---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { copy } from '../lib/content';
import '../styles/sections.css';
---
<Base title={copy.notFound.title} noindex>
  <main class="not-found" id="main" data-theme="styx">
    <Logo class="not-found__logo" title="Roots Tattoo" />
    <h1 class="not-found__title">{copy.notFound.title}</h1>
    <a class="cta" href={import.meta.env.BASE_URL}>{copy.notFound.back}</a>
  </main>
</Base>
