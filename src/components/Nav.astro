---
import Logo from './Logo.astro';
import { copy, studio } from '../lib/content';
---
<a class="skip-link" href="#main">{copy.nav.skip}</a>
<div class="progress" aria-hidden="true"><span class="progress__fill"></span></div>
<header class="nav">
  <a class="nav__logo" href="#top">
    <Logo title={`${studio.name}, na początek historii`} />
  </a>
  <nav class="nav__links" aria-label="Sekcje strony">
    <ul>
      <li><a href="#styx">{copy.nav.styx}</a></li>
      <li><a href="#wkrenta">{copy.nav.wkrenta}</a></li>
      <li><a href="#opinie">{copy.nav.reviews}</a></li>
      <li><a href="#kontakt">{copy.nav.contact}</a></li>
    </ul>
  </nav>
  <div class="nav__toggles">
    <button class="toggle toggle--sound" type="button" aria-pressed="false" aria-label={copy.nav.sound} title={`${copy.nav.sound} (domyślnie wyłączony)`} hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path>
        <path class="toggle__on" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        <path class="toggle__off" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
    <button class="toggle toggle--motion" type="button" aria-pressed="false" aria-label={copy.nav.motionReduce} title={copy.nav.motionReduce} hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path class="toggle__off" d="M3 12c3-5 6-5 9 0s6 5 9 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        <path class="toggle__on" d="M3 12h18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>
