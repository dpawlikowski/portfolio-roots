{
  "name": "studio-tatuazu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/fonts.mjs && node scripts/gen-words.mjs && node scripts/gen-placeholders.mjs && node scripts/lqip.mjs",
    "dev": "node scripts/lqip.mjs && astro dev",
    "build": "node scripts/check-placeholders.mjs && node scripts/lqip.mjs && astro build",
    "build:preview": "node scripts/lqip.mjs && cross-env ALLOW_PLACEHOLDERS=1 astro build",
    "preview": "astro preview --port 4321",
    "check": "node scripts/gen-cms.mjs --check && astro check",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "brand": "node scripts/gen-brand.mjs",
    "cms": "node scripts/gen-cms.mjs",
    "check:cms": "node scripts/gen-cms.mjs --check"
  },
  "dependencies": {
    "astro": "^7.4.11",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "harfbuzzjs": "^1.6.4",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  }
}
